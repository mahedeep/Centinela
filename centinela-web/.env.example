# URL base de la API de agentes (repositorio centinela-agents).
VITE_API_BASE_URL=http://localhost:8000

# true → modo demo: usa respuestas precargadas, sin llamar a la API.
VITE_DEMO_MODE=false

# Repositorio de la API de agentes. Se enlaza desde la pantalla de Ajustes.
# Si lo dejas vacío, la tarjeta simplemente no muestra el enlace.
VITE_AGENTS_REPO_URL=

# Supabase (opcional). Sin estas variables, la app usa acceso por rol local
# guardado en el navegador, suficiente para la demo del curso.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
