# ─────────────────────────────────────────────────────────────────────────────
# Centinela · variables de entorno
# Copia este archivo a `.env` y completa los valores. `.env` está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# --- OpenAI ------------------------------------------------------------------
# Clave de la API de OpenAI. Sin ella el sistema solo funciona con MOCK_MODE=true.
OPENAI_API_KEY=

# Modelos. Los valores por defecto son los que fija el kit del curso.
# ATENCIÓN: verifica que existan en tu cuenta. Si el modelo devuelve 404 el
# cliente reintenta automáticamente con el modelo de respaldo (ver más abajo)
# y lo deja anotado en la traza (campo `model_fallback_used`).
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Modelos de respaldo usados solo si el principal no existe / no está habilitado.
OPENAI_CHAT_FALLBACK_MODEL=gpt-4o-mini
OPENAI_VISION_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_FALLBACK_MODEL=text-embedding-3-small

OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# --- Modos de operación ------------------------------------------------------
# true  → respuestas precalculadas y deterministas, sin llamar a OpenAI.
MOCK_MODE=true
# true  → el agente calcula y registra todo, pero devuelve siempre `aprobar`
#         con shadow=true. Permite pilotar sin bloquear operaciones.
SHADOW_MODE=false

# --- Umbrales de decisión ----------------------------------------------------
THRESHOLD_REVIEW=0.35
THRESHOLD_BLOCK=0.70

# Pesos del score final de transacciones (deben sumar 1,0)
W_TX_RULES=0.45
W_TX_SIMILARITY=0.25
W_TX_MODEL=0.30

# Pesos del score final de documentos (deben sumar 1,0)
W_DOC_VISION=0.40
W_DOC_CHECKS=0.35
W_DOC_MODEL=0.25

# --- Documentos --------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
PDF_RENDER_DPI=150
# Compuerta de calidad: por debajo de este valor el veredicto mínimo es sospechoso.
MIN_IMAGE_QUALITY=0.40
# Motor de OCR / extracción: vision (multimodal OpenAI) | tesseract (local, opcional) | mock
OCR_ENGINE=vision
# Metadatos con software de edición o fecha de modificación posterior a la
# emisión ⇒ veredicto mínimo `sospechoso` (pedir el documento original).
METADATA_WARN_GATE=true
# Días de retención de las imágenes procesadas en data/traces/
TRACE_RETENTION_DAYS=7

# --- Persistencia ------------------------------------------------------------
DATABASE_URL=sqlite:///data/centinela.db
DATA_DIR=data

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Orígenes permitidos, separados por coma. Los localhost:* se permiten siempre.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Exporta openapi.json a la raíz del repo al arrancar (contrato para el front).
EXPORT_OPENAPI=true

# --- Precios (USD por 1M de tokens) ------------------------------------------
# ATENCIÓN: verificar contra la lista de precios vigente de OpenAI antes de
# reportar cifras. Valores por defecto = supuestos del kit (septiembre 2026).
PRICE_CHAT_INPUT_PER_1M=0.10
PRICE_CHAT_OUTPUT_PER_1M=0.60
PRICE_EMBEDDING_INPUT_PER_1M=0.02

# --- Identificación del equipo ----------------------------------------------
TEAM_NAME=Grupo Centinela
TEAM_MEMBERS=Integrante 1, Integrante 2, Integrante 3
